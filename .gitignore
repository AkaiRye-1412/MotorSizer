# Rust build output
/app/target/

# Bundled local toolchain (referenced by build.cmd / run.cmd, kept on disk only)
/app/tools/

# Generated selection reports (created on demand by the export button)
/app/data/reports/

# Local build logs
/app/*.log

# Packaged release folder（安装包通过 Release 附件分发，不进仓库）
/app/dist/

# 厂商原厂样册，受版权保护，仅保留在本地磁盘
/sources/



